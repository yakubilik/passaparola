{
  "expo": {
    "name": "Harfiyen",
    "slug": "harfiyen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skolalabs.harfiyen",
      "infoPlist": {
        "NSCameraUsageDescription": "Harfiyen shows your face inside the letter ring while you play. The picture never leaves your phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.skolalabs.harfiyen",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Harfiyen sesli cevaplarını duymak için mikrofonu kullanır."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Harfiyen sesli cevaplarını duymak için mikrofonu kullanır.",
          "speechRecognitionPermission": "Harfiyen söylediğin cevabı yazıya çevirmek için konuşma tanımayı kullanır."
        }
      ]
    ],
    "scheme": "harfiyen",
    "backgroundColor": "#0a0d1f"
  }
}
