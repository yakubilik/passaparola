+  // Harfiyen: voice processing (echo cancellation) for an engine of this recognizer,
+  // the same for the first engine of a request and for one rebuilt after a route
+  // change. Voice processing ducks every other sound in the app (the host's clips and
+  // the cues play through expo-audio, outside this engine) while it runs, so the game
+  // went quiet as the call-style volume went up: the ducking is switched off.
+  private static func configureVoiceProcessing(
+    _ engine: AVAudioEngine, options: SpeechRecognitionOptions
+  ) {
+    guard options.iosVoiceProcessingEnabled == true else { return }
+    do {
+      try engine.inputNode.setVoiceProcessingEnabled(true)
+      try engine.outputNode.setVoiceProcessingEnabled(true)
+    } catch {
+      print(
+        "expo-speech-recognition: WARNING - Failed to set voice processing: \(error)"
+      )
+    }
+    applyDucking(engine)
+  }
+
+  // Set before the engine starts and again once it runs: the voice-processing I/O
+  // unit is only initialised by start(), and a configuration set before that must
+  // not be the only one it gets.
+  private static func applyDucking(_ engine: AVAudioEngine) {
+    if #available(iOS 17.0, *) {
+      guard engine.inputNode.isVoiceProcessingEnabled else { return }
+      engine.inputNode.voiceProcessingOtherAudioDuckingConfiguration =
+        AVAudioVoiceProcessingOtherAudioDuckingConfiguration(
+          enableAdvancedDucking: false, duckingLevel: .min)
+    }
+  }
+
+  // The engine is let go with voice processing switched off, so the next request
+  // (the next round) builds its voice-processing I/O from the same state as the first
+  // request of the app did, not next to one still held by the old engine.
+  private static func releaseVoiceProcessing(_ engine: AVAudioEngine?) {
+    guard let engine else { return }
+    if engine.inputNode.isVoiceProcessingEnabled {
+      try? engine.inputNode.setVoiceProcessingEnabled(false)
+      try? engine.outputNode.setVoiceProcessingEnabled(false)
+    }
+    HarfiyenVoiceProcessing.update { $0["running"] = false }
+  }
+
+  private static func recordVoiceProcessing(_ engine: AVAudioEngine, rebuilt: Bool) {
+    let enabled = engine.inputNode.isVoiceProcessingEnabled
+    var advanced: Any = NSNull()
+    var level: Any = NSNull()
+    if #available(iOS 17.0, *), enabled {
+      let config = engine.inputNode.voiceProcessingOtherAudioDuckingConfiguration
+      advanced = config.enableAdvancedDucking.boolValue
+      switch config.duckingLevel {
+      case .min: level = "min"
+      case .mid: level = "mid"
+      case .max: level = "max"
+      case .default: level = "default"
+      @unknown default: level = "\(config.duckingLevel.rawValue)"
+      }
+    }
+    HarfiyenVoiceProcessing.update { state in
+      state["running"] = engine.isRunning
+      state["enabled"] = enabled
+      state["advancedDucking"] = advanced
+      state["duckingLevel"] = level
+      state["engines"] = ((state["engines"] as? Int) ?? 0) + 1
+      if rebuilt { state["rebuilds"] = ((state["rebuilds"] as? Int) ?? 0) + 1 }
+    }
+  }
