+// Harfiyen: the voice processing of the recognizer's audio engine as it last was,
+// for the app's audio diagnostic (getVoiceProcessingStateIOS). Read from the
+// engine's own input node after it started, not from the options asked for.
+final class HarfiyenVoiceProcessing {
+  private static let lock = NSLock()
+  private static var state: [String: Any] = [
+    "running": false, "enabled": false, "advancedDucking": NSNull(), "duckingLevel": NSNull(),
+    "engines": 0, "rebuilds": 0,
+  ]
+
+  static func snapshot() -> [String: Any] {
+    lock.lock()
+    defer { lock.unlock() }
+    return state
+  }
+
+  static func update(_ change: (inout [String: Any]) -> Void) {
+    lock.lock()
+    change(&state)
+    lock.unlock()
+  }
+}
